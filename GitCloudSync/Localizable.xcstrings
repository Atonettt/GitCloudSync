          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 GitHub Desktop 中使用「Publish repository」发布该仓库，或执行 git remote add origin <地址>。"
          }
        }
      }
    },
    "请先在设置中填写 OAuth App 的 Client ID（需要在 GitHub 开发者设置中启用 Device Flow）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the Client ID of your OAuth App in Settings first (Device Flow must be enabled in GitHub developer settings)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
