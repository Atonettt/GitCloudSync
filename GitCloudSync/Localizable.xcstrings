        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n尝试记录：\n"
          }
        }
      }
    },
    "\n未提交修改：%lld 个，领先 %lld，落后 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nUncommitted changes: %lld, ahead %lld, behind %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n未提交修改：%lld 个，领先 %lld，落后 %lld"
