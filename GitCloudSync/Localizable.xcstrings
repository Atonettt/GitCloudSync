    "删除两者": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Both"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除两者"
          }
        }
      }
    },
    "删除后此文件夹变成仅本地、暂停同步；以后可在「更多」中重新发布到新的 GitHub 仓库。另一台 Mac 上的这个仓库将无法再同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After deletion this folder becomes local-only and stops syncing; you can publish it to a new GitHub repository later from “More”. This repository on your other Mac will no longer sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后此文件夹变成仅本地、暂停同步；以后可在「更多」中重新发布到新的 GitHub 仓库。另一台 Mac 上的这个仓库将无法再同步。"
          }
        }
      }
    },
    "删除时间": {
      "localizations": {
