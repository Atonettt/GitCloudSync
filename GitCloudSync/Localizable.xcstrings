            "state": "translated",
            "value": "%@ 已同步"
          }
        }
      }
    },
    "%@ 已改为仅本地，原远程改名为 %@ 以保留已下载的提交": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is now local-only; the old remote was renamed to %@ to keep downloaded commits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已改为仅本地，原远程改名为 %@ 以保留已下载的提交"
          }
        }
      }
    },
    "%@ 已移动到 %@，继续同步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moved to %@; syncing continues"
