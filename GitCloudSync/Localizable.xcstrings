    " 等 %lld 个": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld in total)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 等 %lld 个"
          }
        }
      }
    },
    "#!/bin/zsh\necho \"GitSync — 登录 GitHub CLI\"\necho \"将打开浏览器完成授权，完成后回到 GitSync 点击「重新检测」。\"\necho\n\"%@\" auth login --hostname github.com --git-protocol https --web\necho\necho \"完成。可以关闭此窗口。\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#!/bin/zsh\necho \"GitSync — Sign in to GitHub CLI\"\necho \"A browser will open for authorization. When you're done, return to GitSync and click “Check Again”.\"\necho\n\"%@\" auth login --hostname github.com --git-protocol https --web\necho\necho \"Done. You can close this window.\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#!/bin/zsh\necho \"GitSync — 登录 GitHub CLI\"\necho \"将打开浏览器完成授权，完成后回到 GitSync 点击「重新检测」。\"\necho\n\"%@\" auth login --hostname github.com --git-protocol https --web\necho\necho \"完成。可以关闭此窗口。\""
          }
        }
      }
    },
