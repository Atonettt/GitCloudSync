    "将创建 github.com/%@/%@，本地文件夹名保持「%@」不变。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will create github.com/%@/%@; the local folder keeps the name “%@”."
          }
