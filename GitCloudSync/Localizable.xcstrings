        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中输入上面的验证码并授权，完成后此窗口会自动更新。"
          }
        }
      }
    },
    "请安装 Xcode Command Line Tools（xcode-select --install）或 Homebrew Git，或在设置中指定 git 路径。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Xcode Command Line Tools (xcode-select --install) or Homebrew Git, or set the git path in Settings."
          }
        },
