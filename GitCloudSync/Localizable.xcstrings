            "value": "历史 %@"
          }
        }
      }
    },
    "历史中最占空间的文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files Using the Most History Space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史中最占空间的文件"
          }
        }
      }
    },
    "历史保存了每次同步时的版本。纯文本只多存改动的部分；Word、PPT、PDF、图片、视频这类文件每修改一次，历史里大约就多存一整份。删除文件也不会让历史变小，旧版本仍然保留，可以在「历史版本」里找回。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History keeps the version from every sync. Plain text only adds the changed parts, but Word, PPT, PDF, images and videos add roughly a full copy each time they change. Deleting files doesn't shrink history; old versions stay and can be recovered in “Version History”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史保存了每次同步时的版本。纯文本只多存改动的部分；Word、PPT、PDF、图片、视频这类文件每修改一次，历史里大约就多存一整份。删除文件也不会让历史变小，旧版本仍然保留，可以在「历史版本」里找回。"
          }
        }
      }
    },
    "历史已占用 %@，超过 GitHub 建议的 1 GB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History uses %@, above GitHub's recommended 1 GB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史已占用 %@，超过 GitHub 建议的 1 GB"
          }
        }
      }
    },
    "历史已占用 %@，超过 GitHub 的 5 GB 警告线": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History uses %@, above GitHub's 5 GB warning level"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史已占用 %@，超过 GitHub 的 5 GB 警告线"
          }
        }
      }
    },
    "历史版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史版本"
          }
        }
      }
    },
    "原来的位置：%@。如果移动过它，选出新位置后会继续同步；如果已经删除，可以从 GitHub 重新下载。设置和历史都保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Originally at %@. If you moved it, choose its new location to keep syncing; if it was deleted, download it again from GitHub. Settings and history are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来的位置：%@。如果移动过它，选出新位置后会继续同步；如果已经删除，可以从 GitHub 重新下载。设置和历史都保留。"
          }
        }
      }
    },
    "双击文件用默认应用打开，双击文件夹进入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a file to open it, or a folder to go into it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击文件用默认应用打开，双击文件夹进入。"
          }
        }
      }
    },
    "双击进入这个文件夹。": {
      "localizations": {
