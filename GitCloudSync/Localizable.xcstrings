            "state": "translated",
            "value": "%@ · 版本历史"
          }
        }
      }
    },
    "%@ — 移到废纸篓（可以从废纸篓放回），并从列表移除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — moves it to the Trash (you can put it back) and removes it from the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 移到废纸篓（可以从废纸篓放回），并从列表移除。"
          }
        }
      }
    },
    "%@ 删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 删除"
          }
        }
      }
    },
    "%@ 同步失败": {
